{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "van-hanh-dc-hung-yen-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "vars": {
    "PROJECT_ID": "VAN_HANH_DC_HUNG_YEN"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "van-hanh-dc-hung-yen",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GROUP_REALTIME",
        "class_name": "GroupRealtime"
      }
    ]
  },
  "exports": {
    "GroupRealtime": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
